DB_HOST=localhost
DB_PORT=5432
DB_NAME=PurchasingOrganization
DB_USER=postgres
# Senhas com caracteres especiais (# $ espaco) devem ficar entre aspas simples: DB_PASS='s#nh$a'
DB_PASS=postgres

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PREFIX=pt:

APP_ENV=development
APP_DEBUG=true

# Railway (producao): segredo compartilhado com o proxy do frontend.
# Vazio = desativado (desenvolvimento local)
INTERNAL_TOKEN=
# Redis com senha (Railway). Vazio no Redis local do docker compose
REDIS_PASSWORD=
# Limite de requisicoes por cliente por minuto (0 desativa)
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_WRITES_PER_MINUTE=60

# Primeiro usuario: criado no deploy (migrate.php) se a tabela users estiver vazia.
# Depois, os usuarios sao gerenciados no app (Usuarios) e estas variaveis podem sair.
# Gere o hash com: php bin/hash-password.php  (no .env use aspas simples: o hash contem "$")
# Alternativa: php bin/create-user.php
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=

# Origens externas autorizadas a chamar a API (separadas por virgula). Vazio = nenhuma;
# o app usa a mesma origem (/api pelo proxy), entao normalmente fica vazio.
CORS_ALLOWED_ORIGINS=
